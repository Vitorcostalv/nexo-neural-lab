  "cards": [
    {
      "id": "elizabeth-ii",
      "title": "Elizabeth II",
      "aliases": [
        "elizabeth ii",
        "elisabeth ii",
        "isabel ii",
        "rainha da inglaterra",
        "rainha do reino unido",
        "rainha britanica"
      ],
      "sourceIds": [
        "queen-death",
        "queen-birth"
      ],
      "rules": [
        {
          "id": "age",
          "pattern": "quantos anos|idade|velha",
          "exclude": "coroa|casou|casamento|assumiu|comecou|começou|nasceu|teria|hoje",
          "answer": "Se você se refere a Elizabeth II, ela morreu aos 96 anos, em 8 de setembro de 2022. Ela era rainha do Reino Unido; por isso, sua idade é informada como idade ao falecer.",
          "sourceIds": [
            "queen-death"
          ]
        },
        {
          "id": "latest",
          "pattern": "ultima|mais recente",
          "answer": "Na monarquia britânica recente, a última rainha reinante foi Elizabeth II, que morreu aos 96 anos em 2022. No sentido histórico estrito de Reino da Inglaterra, a última rainha foi Ana (Anne), antes da união com a Escócia em 1707.",
          "sourceIds": [
            "queen-death",
            "anne"
          ]
        },
        {
          "id": "death",
          "pattern": "quando.*(morreu|faleceu)|data.*(morte|falecimento)",
          "answer": "Elizabeth II morreu em 8 de setembro de 2022, aos 96 anos.",
          "sourceIds": [
            "queen-death"
          ]
        },
        {
          "id": "identity",
          "pattern": "quem|qual.*rainha|fale sobre|conte sobre",
          "answer": "Elizabeth II foi rainha do Reino Unido de 1952 a 2022. Ela morreu aos 96 anos; não deve ser confundida com Elizabeth I, uma monarca de outro período.",
          "sourceIds": [
            "queen-death",
            "queen-birth"
          ]
        }
      ]
    },
    {
      "id": "elizabeth-i",
      "title": "Elizabeth I",
      "aliases": [
        "elizabeth i",
        "elisabeth i",
        "isabel i"
      ],
      "sourceIds": [
        "monarchs"
      ],
      "rules": [
        {
          "id": "reign",
          "pattern": "quem|quando|reinou|reinado|fale sobre",
          "answer": "Elizabeth I reinou na Inglaterra de 1558 a 1603. Ela não foi a rainha britânica falecida em 2022: essa foi Elizabeth II."
        }
      ]
    },
    {
      "id": "queen-anne",
      "title": "Rainha Ana (Anne)",
      "aliases": [
        "rainha ana",
        "rainha anne",
        "queen anne"
      ],
      "sourceIds": [
        "anne"
      ],
      "rules": [
        {
          "id": "reign",
          "pattern": "quem|quando|reinou|reinado|ultima|fale sobre",
          "answer": "Ana (Anne) reinou de 1702 a 1714. Em 1707, a união da Inglaterra com a Escócia formou a Grã-Bretanha durante seu reinado."
        }
      ]
    },
    {
      "id": "solar-system",
      "title": "Sistema Solar",
      "aliases": [
        "sistema solar"
      ],
      "sourceIds": [
        "solar",
        "planets"
      ],
      "rules": [
        {
          "id": "count",
          "pattern": "quantos planetas|quantidade de planetas|numero de planetas|oito planetas",
          "answer": "O Sistema Solar tem oito planetas. Plutão é classificado como planeta anão."
        },
        {
          "id": "order",
          "pattern": "ordem|quais.*planetas|nome.*planetas",
          "answer": "A partir do Sol, os oito planetas são Mercúrio, Vênus, Terra, Marte, Júpiter, Saturno, Urano e Netuno."
        },
        {
          "id": "largest",
          "pattern": "maior planeta",
          "answer": "Júpiter é o maior planeta do Sistema Solar."
        },
        {
          "id": "smallest",
          "pattern": "menor planeta",
          "answer": "Mercúrio é o menor dos oito planetas do Sistema Solar."
        },
        {
          "id": "definition",
          "pattern": "o que|oq|explique|explica|fale sobre",
          "answer": "O Sistema Solar reúne o Sol e os corpos que orbitam ao seu redor, incluindo oito planetas, planetas anões, luas e pequenos corpos."
        }
      ]
    },
    {
      "id": "sun",
